# ── Database ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ── Sessions ────────────────────────────────────────────────────────────
# HMAC secret used to sign session JWT cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-with-a-long-random-string

# Absolute origin of the deployed app (no trailing slash). Used to build OAuth
# redirect URIs: {APP_URL}/api/auth/callback/google
APP_URL=http://localhost:3000

# ── OAuth: Google ───────────────────────────────────────────────────────
# Create credentials in Google Cloud Console → APIs & Services → OAuth 2.0,
# and add {APP_URL}/api/auth/callback/google to "Authorized redirect URIs".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── OAuth: GitHub ───────────────────────────────────────────────────────
# GitHub → Settings → Developer settings → OAuth Apps.
# Authorization callback URL: {APP_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Optional ────────────────────────────────────────────────────────────
# Real fingerprint recognition (otherwise recognition runs fully on-device)
ACRCLOUD_CLIENT_KEY=
ACRCLOUD_CLIENT_SECRET=
ACRCLOUD_HOST=identify-eu-west-1.acrcloud.com
# Lyrics
GENIUS_API_KEY=
# Audio cache directory (defaults to /tmp/calamify-audio)
CALAMIFY_CACHE_DIR=
